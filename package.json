{
  "name": "@2768651338/dsh-plugin-manager",
  "description": "插件管家——图形化插件管理：中文名与用途说明目录 + 一键启停（写入全局 cordis.patch.yml，实时热生效）",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale",
        "remote"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.0 || >=0.1.5-rc.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.0 || >=0.1.5-rc.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config ./tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node tests/patch-file.smoke.mjs && node tests/backup.smoke.mjs && node tests/claims.e2e.mjs && node tests/gateway-path.e2e.mjs && node tests/host-gateway.e2e.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/typert.host.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-api-gateway": "0.1.5-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.3",
    "@deepseek-ai/dsh-app-boot": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.3",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.3",
    "@deepseek-ai/dsh-typert-loader": "0.1.5-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.1.5-rc.3",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.1",
    "js-yaml": "^4.3.2",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
