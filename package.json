{
  "name": "@dsh-external/dsh-plugin-manager",
  "description": "插件管家——图形化插件管理：中文名与用途说明目录 + 一键启停（写入全局 cordis.patch.yml，实时热生效）",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale",
        "remote"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config ./tsdown.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/typert.host.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}